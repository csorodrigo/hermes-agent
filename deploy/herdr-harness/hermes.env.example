# Install this integration on the machine that runs the Hermes process.
HERDR_HARNESS_PROFILE=hermes-bot
HERDR_HARNESS_AUTO_ENABLE=1

# Optional override when the controller is not on PATH.
# HERDR_HARNESS_CTL=/home/hermes-bot/.local/bin/herdr-hermesctl

# Hermes can run on the workbox itself (local terminal backend), or on a
# controller host using the existing SSH terminal backend below.
TERMINAL_ENV=ssh
TERMINAL_SSH_HOST=hermes-workbox
TERMINAL_SSH_USER=hermes-bot
TERMINAL_SSH_PORT=22
TERMINAL_SSH_KEY=~/.ssh/id_ed25519_hermes

# Keep dangerous-command approvals enabled for team/gateway usage.
# HERMES_YOLO_MODE must remain unset.
